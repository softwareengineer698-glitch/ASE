rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // TEMPORARY DEBUG RULES - VERY PERMISSIVE FOR TESTING
    // DO NOT USE IN PRODUCTION
    // This allows all authenticated users to read and write any document
    
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
