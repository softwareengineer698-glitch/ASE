rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isDonor() {
      return isSignedIn() && getUserRole() == "donor";
    }
    
    function isNGO() {
      return isSignedIn() && getUserRole() == "ngo";
    }

    function isClaimParticipant() {
      return isSignedIn() && (
        resource.data.claimantId == request.auth.uid ||
        resource.data.donorId == request.auth.uid
      );
    }

    function isChatParticipant(roomId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participantIds;
    }

    // Users collection
    match /users/{userId} {
      allow create: if isSignedIn()
        && isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email != null
        && request.resource.data.role != null
        && request.resource.data.createdAt != null;

      // Allow all authenticated users to read (needed for cross-collection queries)
      allow read: if isSignedIn();
      
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    // DONATIONS COLLECTION
    match /donations/{donationId} {
      allow create: if isSignedIn()
        && request.resource.data.donorId == request.auth.uid;

      allow read: if isSignedIn();

      // Any authenticated user can update donations (handles partial claims, expiry, etc.)
      allow update: if isSignedIn() && (
        resource.data.donorId == request.auth.uid ||
        isNGO() ||
        // Expiry service running as any authenticated user
        isSignedIn()
      );

      allow delete: if isSignedIn() && resource.data.donorId == request.auth.uid;
    }

    // Surplus reports collection
    match /surplus_reports/{reportId} {
      // Donors can create their own surplus reports
      allow create: if isSignedIn()
        && request.resource.data.donorId == request.auth.uid
        && request.resource.data.foodType != null
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0;

      // All authenticated users can read surplus reports
      allow read: if isSignedIn();
      
      // Donors can update their own reports, NGOs can update status
      allow update: if isSignedIn() && (
        resource.data.donorId == request.auth.uid ||
        // Allow NGOs to update status only
        (request.resource.data.keys().hasOnly(['status']) && 
         request.resource.data.keys().hasAll(['status']))
      );

      // Only donors can delete their own reports
      allow delete: if isSignedIn() && resource.data.donorId == request.auth.uid;
    }

    // NGO requests collection
    match /ngo_requests/{requestId} {
      // NGOs can create requests
      allow create: if isSignedIn()
        && request.resource.data.ngoId == request.auth.uid
        && request.resource.data.surplusId != null
        && request.resource.data.status != null;

      // All authenticated users can read NGO requests
      allow read: if isSignedIn();
      
      // NGOs can update their own requests
      allow update: if isSignedIn()
        && resource.data.ngoId == request.auth.uid;

      // NGOs can delete their own requests
      allow delete: if isSignedIn() && resource.data.ngoId == request.auth.uid;
    }

    // Claims collection
    match /claims/{claimId} {
      allow create: if isSignedIn()
        && request.resource.data.claimantId == request.auth.uid;

      allow read: if isSignedIn() && (
        resource.data.claimantId == request.auth.uid ||
        resource.data.donorId == request.auth.uid
      );

      allow update: if isSignedIn() && (
        resource.data.donorId == request.auth.uid ||
        resource.data.claimantId == request.auth.uid
      );

      allow delete: if false;
    }

    // Delivery requests for volunteer transport
    match /deliveries/{deliveryId} {
      allow create: if isSignedIn()
        && request.resource.data.ngoId == request.auth.uid
        && request.resource.data.donationId != null
        && request.resource.data.donorId != null
        && request.resource.data.status == 'pending';

      allow read: if isSignedIn() && (
        resource.data.ngoId == request.auth.uid ||
        resource.data.donorId == request.auth.uid ||
        resource.data.volunteerId == request.auth.uid ||
        (
          getUserRole() == "volunteer" &&
          (resource.data.volunteerId == '' || resource.data.volunteerId == request.auth.uid)
        )
      );

      allow update: if isSignedIn() && (
        resource.data.ngoId == request.auth.uid ||
        resource.data.donorId == request.auth.uid ||
        resource.data.volunteerId == request.auth.uid ||
        (
          getUserRole() == "volunteer" &&
          resource.data.volunteerId == '' &&
          request.resource.data.volunteerId == request.auth.uid
        )
      );
    }

    // Chat rooms and nested messages
    match /chat_rooms/{roomId} {
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() >= 2;

      allow read, update: if isSignedIn()
        && request.auth.uid in resource.data.participantIds;

      match /messages/{messageId} {
        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participantIds
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.sentAt != null;

        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participantIds;

        // Only the sender can delete their own message
        allow delete: if isSignedIn()
          && resource.data.senderId == request.auth.uid;
      }
    }

    // Profiles collection
    match /profiles/{userId} {
      allow create, read, update, delete: if isSignedIn() && isOwner(userId);
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isSignedIn() 
        && resource.data.userId == request.auth.uid;
    }
  }
}
