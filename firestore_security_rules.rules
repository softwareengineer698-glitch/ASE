      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
        && resource.size < 10 * 1024 * 1024 // 10MB limit
        && resource.contentType.matches('image/.*');
    }
    
    // NGO verification documents
    match /verification_docs/{ngoId}/{documentId} {
      allow read: if request.auth != null && (
        request.auth.uid == ngoId ||
        // Check if user is admin (requires custom token claim)
        request.auth.token.admin == true
      );
      allow write: if request.auth != null && request.auth.uid == ngoId
        && resource.size < 25 * 1024 * 1024 // 25MB limit
        && (resource.contentType.matches('image/.*') || 
            resource.contentType.matches('application/pdf'));
    }
    
    // User profile photos
    match /profile_photos/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
        && resource.size < 5 * 1024 * 1024 // 5MB limit
        && resource.contentType.matches('image/.*');
    }
    
    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
