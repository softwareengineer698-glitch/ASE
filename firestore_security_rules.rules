rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===== HELPER FUNCTIONS =====
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.isActive == true;
    }
    
    function isDonor() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'donor';
    }
    
    function isNGO() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ngo';
    }
    
    function isVerifiedNGO() {
      return isNGO() && 
        exists(/databases/$(database)/documents/ngo_verifications/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/ngo_verifications/$(request.auth.uid)).data.status == 'approved';
    }

    // ===== CORE COLLECTIONS =====

    // Users collection - Enhanced
    match /users/{userId} {
      allow create: if isSignedIn()
        && isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email != null
        && request.resource.data.role in ['donor', 'ngo']
        && request.resource.data.createdAt != null
        && request.resource.data.keys().hasAll(['uid', 'email', 'role', 'createdAt']);

      allow read: if isSignedIn();
      
      allow update: if isSignedIn() && isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role;
        
      allow delete: if isSignedIn() && isOwner(userId);
    }

    // Surplus reports collection - Enhanced
    match /surplus_reports/{reportId} {
      allow create: if isDonor()
        && request.resource.data.donorId == request.auth.uid
        && request.resource.data.foodType != null
        && request.resource.data.quantity is number
        && request.resource.data.quantity > 0
        && request.resource.data.status == 'available'
        && request.resource.data.createdAt != null;

      allow read: if isSignedIn();
      
      allow update: if isSignedIn() && (
        // Donors can update their own reports (except status when accepted)
        (resource.data.donorId == request.auth.uid && 
         !(resource.data.status == 'accepted' && request.resource.data.status != 'accepted')) ||
        // Verified NGOs can update status and related fields
        (isVerifiedNGO() && 
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'acceptedBy', 'acceptedAt', 'updatedAt']))
      );

      allow delete: if isDonor() && resource.data.donorId == request.auth.uid
        && resource.data.status == 'available';
    }

    // NGO requests collection - Enhanced
    match /ngo_requests/{requestId} {
      allow create: if isVerifiedNGO()
        && request.resource.data.ngoId == request.auth.uid
        && request.resource.data.surplusId != null
        && request.resource.data.status in ['pending', 'submitted']
        && request.resource.data.createdAt != null;

      allow read: if isSignedIn();
      
      allow update: if isSignedIn() && (
        // NGOs can update their own requests
        resource.data.ngoId == request.auth.uid ||
        // Donors can update status for their surplus
        (isDonor() && 
         exists(/databases/$(database)/documents/surplus_reports/$(resource.data.surplusId)) &&
         get(/databases/$(database)/documents/surplus_reports/$(resource.data.surplusId)).data.donorId == request.auth.uid)
      );

      allow delete: if isVerifiedNGO() && resource.data.ngoId == request.auth.uid;
    }

    // ===== NEW FEATURE COLLECTIONS =====

    // Donations collection - Real-time donation system
    match /donations/{donationId} {
      allow create: if isDonor()
        && request.resource.data.donorId == request.auth.uid
        && request.resource.data.title != null
        && request.resource.data.description != null
        && request.resource.data.category != null
        && request.resource.data.quantity is number
        && request.resource.data.quantity > 0
        && request.resource.data.unit != null
        && request.resource.data.location != null
        && request.resource.data.imageUrls is list
        && request.resource.data.expiryTime != null
        && request.resource.data.status == 'available'
        && request.resource.data.timestamp != null;

      allow read: if isSignedIn();

      allow update: if isSignedIn() && (
        // Donors can update their own donations (only description, images, location, expiry)
        (resource.data.donorId == request.auth.uid && 
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['description', 'imageUrls', 'location', 'expiryTime', 'updatedAt'])) ||
        // NGOs can claim available donations
        (isNGO() && 
         resource.data.status == 'available' &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'claimedBy', 'claimedAt', 'updatedAt']) &&
         request.resource.data.status == 'claimed' &&
         request.resource.data.claimedBy == request.auth.uid) ||
        // Donors can complete claimed donations
        (isDonor() && 
         resource.data.donorId == request.auth.uid &&
         resource.data.status == 'claimed' &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'completedAt', 'updatedAt']) &&
         request.resource.data.status == 'completed')
      );

      allow delete: if isDonor() && 
        resource.data.donorId == request.auth.uid &&
        resource.data.status == 'available';
    }

    // Analytics data collection
    match /analytics/{userId} {
      allow create, read, update: if isSignedIn() && isOwner(userId);
      allow delete: if false; // Prevent deletion of analytics data
    }

    // Delivery confirmations collection
    match /delivery_confirmations/{confirmationId} {
      allow create: if isSignedIn()
        && (request.resource.data.donorId == request.auth.uid || 
            request.resource.data.ngoId == request.auth.uid)
        && request.resource.data.createdAt != null;

      allow read: if isSignedIn() && (
        resource.data.donorId == request.auth.uid ||
        resource.data.ngoId == request.auth.uid ||
        isAdmin()
      );
      
      allow update: if isSignedIn() && (
        resource.data.donorId == request.auth.uid ||
        resource.data.ngoId == request.auth.uid
      );

      allow delete: if isAdmin(); // Only admins can delete confirmations
    }

    // Delivery photos subcollection
    match /delivery_confirmations/{confirmationId}/photos/{photoId} {
      allow create, read, update: if isSignedIn() && (
        get(/databases/$(database)/documents/delivery_confirmations/$(confirmationId)).data.donorId == request.auth.uid ||
        get(/databases/$(database)/documents/delivery_confirmations/$(confirmationId)).data.ngoId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // NGO verification collection
    match /ngo_verifications/{ngoId} {
      allow create: if isNGO() && isOwner(ngoId)
        && request.resource.data.ngoId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.submittedAt != null;

      allow read: if isSignedIn() && (isOwner(ngoId) || isAdmin());
      
      allow update: if (isNGO() && isOwner(ngoId) && resource.data.status == 'pending') ||
                      isAdmin();

      allow delete: if isAdmin();
    }

    // Verification documents subcollection
    match /ngo_verifications/{ngoId}/documents/{documentId} {
      allow create, read, update: if isSignedIn() && (isOwner(ngoId) || isAdmin());
      allow delete: if isAdmin();
    }

    // Admin users collection
    match /admin_users/{adminId} {
      allow read: if isSignedIn() && isOwner(adminId);
      allow create, update, delete: if false; // Only server-side operations
    }

    // Push notification preferences
    match /notification_preferences/{userId} {
      allow create, read, update, delete: if isSignedIn() && isOwner(userId);
    }

    // Push notifications collection - Enhanced
    match /notifications/{notificationId} {
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      
      allow read, update: if isSignedIn() && 
        resource.data.userId == request.auth.uid;
        
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // Forecast data collection
    match /forecasts/{userId} {
      allow create, read, update: if isDonor() && isOwner(userId);
      allow delete: if false; // Prevent deletion of forecast data
    }

    // Leaderboard data collection
    match /leaderboards/{period} {
      allow read: if isSignedIn();
      allow create, update, delete: if false; // Only server-side operations
    }

    // User achievements collection
    match /achievements/{userId} {
      allow read: if isSignedIn() && isOwner(userId);
      allow create, update: if false; // Only server-side operations
      allow delete: if isAdmin();
    }

    // User preferences (theme, language, etc.)
    match /user_preferences/{userId} {
      allow create, read, update, delete: if isSignedIn() && isOwner(userId);
    }

    // ===== TRACKING & AUDIT COLLECTIONS =====

    // Activity logs collection
    match /activity_logs/{logId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.timestamp != null;
        
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      
      allow update, delete: if false; // Logs are immutable
    }

    // System metrics collection (for analytics)
    match /system_metrics/{metricId} {
      allow read: if isAdmin();
      allow create, update, delete: if false; // Only server-side operations
    }

    // ===== LEGACY COLLECTIONS (MAINTAINED) =====

    // Profiles collection - Enhanced
    match /profiles/{userId} {
      allow create, read, update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId) && !isAdmin();
    }

    // ===== SUBCOLLECTIONS =====

    // User statistics subcollection
    match /users/{userId}/statistics/{statId} {
      allow read: if isSignedIn() && isOwner(userId);
      allow create, update, delete: if false; // Only server-side operations
    }

    // Notification history subcollection
    match /users/{userId}/notification_history/{historyId} {
      allow create, read: if isSignedIn() && isOwner(userId);
      allow update, delete: if false; // History is immutable
    }

    // ===== SECURITY RULES FOR FILE UPLOADS =====

    // Photo metadata collection (for delivery confirmations)
    match /photo_metadata/{photoId} {
      allow create, read: if isSignedIn();
      allow update: if isSignedIn() && resource.data.uploadedBy == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Document metadata collection (for NGO verification)
    match /document_metadata/{documentId} {
      allow create, read: if isSignedIn();
      allow update: if isSignedIn() && resource.data.uploadedBy == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ===== CATCH-ALL RULE =====
    // Deny access to any other collections not explicitly defined
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// ===== FIREBASE STORAGE RULES (COMPANION FILE) =====
// Note: These should be added to your Firebase Storage rules

