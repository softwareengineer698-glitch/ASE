rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Permissive rules for functionality - allows cross-collection reads
    match /users/{userId} {
      // Allow all authenticated users to read user documents (needed for donor info)
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    match /surplus_reports/{reportId} {
      allow create: if request.auth != null && request.resource.data.donorId == request.auth.uid;
      // Allow all authenticated users to read surplus reports
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    match /ngo_requests/{requestId} {
      allow create: if request.auth != null && request.resource.data.ngoId == request.auth.uid;
      // Allow all authenticated users to read NGO requests
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    match /profiles/{userId} {
      allow create, read, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    match /notifications/{notificationId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
