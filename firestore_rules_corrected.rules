rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow create: if isSignedIn()
        && isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email != null
        && request.resource.data.role != null
        && request.resource.data.createdAt != null;

      // Allow all authenticated users to read (needed for cross-collection queries)
      allow read: if isSignedIn();
      
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    // Surplus reports collection - FIXED RULES
    match /surplus_reports/{reportId} {
      // Donors can create their own surplus reports
      allow create: if isSignedIn()
        && request.resource.data.donorId == request.auth.uid
        && request.resource.data.foodType != null
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0;

      // All authenticated users can read surplus reports
      allow read: if isSignedIn();
      
      // FIXED: Allow donors to update their own reports, and NGOs to update status
      allow update: if isSignedIn() && (
        // Donors can update their own reports
        resource.data.donorId == request.auth.uid ||
        // NGOs can update status field only (simplified condition)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
      );

      // Only donors can delete their own reports
      allow delete: if isSignedIn() && resource.data.donorId == request.auth.uid;
    }

    // NGO requests collection
    match /ngo_requests/{requestId} {
      // NGOs can create requests
      allow create: if isSignedIn()
        && request.resource.data.ngoId == request.auth.uid
        && request.resource.data.surplusId != null
        && request.resource.data.status != null;

      // All authenticated users can read NGO requests
      allow read: if isSignedIn();
      
      // NGOs can update their own requests
      allow update: if isSignedIn()
        && resource.data.ngoId == request.auth.uid;

      // NGOs can delete their own requests
      allow delete: if isSignedIn() && resource.data.ngoId == request.auth.uid;
    }

    // Profiles collection
    match /profiles/{userId} {
      allow create, read, update, delete: if isSignedIn() && isOwner(userId);
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isSignedIn() 
        && resource.data.userId == request.auth.uid;
    }
  }
}
